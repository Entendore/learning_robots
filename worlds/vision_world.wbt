#VRML_SIM R2023b utf8
# Vision world: goals are TALL BEACONS (visible to the e-puck camera).
# Learners use controllers/vision_agent:
#   --mode=blob    tabular Q-learning on colour-blob state (default, fast)
#   --mode=pixels  end-to-end Double-DQN over a downsampled colour grid
# Calibrate --rgb/--tol first with worlds/vision_check.wbt.

WorldInfo {
  basicTimeStep 16
}
Viewpoint {
  orientation 1 0 0 -0.9
  position 0 3.5 3.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 4.5 4.5
  wallHeight 0.1
}

# --- obstacles ---
Solid {
  translation 0.7 0.075 0.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.55 0.75
      }
      geometry DEF PILLAR Cylinder {
        height 0.15
        radius 0.15
      }
    }
  ]
  boundingObject USE PILLAR
}
Solid {
  translation -0.2 0.075 -0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.55 0.75
      }
      geometry Cylinder {
        height 0.15
        radius 0.1
      }
    }
  ]
  boundingObject Cylinder {
    height 0.15
    radius 0.1
  }
}

# --- beacon goals (emissive => colour stable under lighting) ---
DEF BEACON_YELLOW Solid {
  translation 1.2 0.25 1.2
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.7 0.1
        emissiveColor 0.55 0.45 0.06
      }
      geometry DEF BEACON_CYL Cylinder {
        height 0.5
        radius 0.08
      }
    }
  ]
  boundingObject USE BEACON_CYL
}
DEF BEACON_CYAN Solid {
  translation -1.2 0.25 1.2
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.72 0.78
        emissiveColor 0.06 0.45 0.49
      }
      geometry USE BEACON_CYL
    }
  ]
  boundingObject USE BEACON_CYL
}
DEF BEACON_RED Solid {
  translation 0 0.25 -1.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.16 0.12
        emissiveColor 0.52 0.1 0.08
      }
      geometry USE BEACON_CYL
    }
  ]
  boundingObject USE BEACON_CYL
}

# --- learners ---
DEF ROBOT1 E-puck {
  translation -1.5 0.03 -1.5
  rotation 0 1 0 0.6
  name "visrobot1"
  supervisor TRUE
  controller "vision_agent"
  controllerArgs [
    "--mode=blob"
    "--color=yellow"
    "--goal=1.2,1.2"
    "--qtable=qtable_vision1.json"
  ]
}
DEF ROBOT2 E-puck {
  translation 1.5 0.03 -1.2
  rotation 0 1 0 2.4
  name "visrobot2"
  supervisor TRUE
  controller "vision_agent"
  controllerArgs [
    "--mode=blob"
    "--color=cyan"
    "--goal=-1.2,1.2"
    "--qtable=qtable_vision2.json"
  ]
}
DEF ROBOT3 E-puck {
  translation 0 0.03 1.8
  rotation 0 1 0 3.6
  name "visrobot3"
  supervisor TRUE
  controller "vision_agent"
  controllerArgs [
    "--mode=blob"
    "--color=red"
    "--goal=0,-1.3"
    "--qtable=qtable_vision3.json"
  ]
}
