#VRML_SIM R2023b utf8
# Benchmark: robotQ (Q-learning) vs robotSARSA on mirrored tasks with
# identical seeds. Compare progress_robotQ.csv vs progress_robotSARSA.csv:
#   python3 tools/plot_progress.py \
#       controllers/qlearning_agent/progress_robotQ.csv \
#       controllers/qlearning_agent/progress_robotSARSA.csv

WorldInfo {
  basicTimeStep 16
}
Viewpoint {
  orientation 1 0 0 -0.9
  position 0 3.5 3.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 4.5 4.5
  wallHeight 0.1
}

Solid {
  translation 0.7 0.075 0.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.55 0.75
      }
      geometry DEF PILLAR Cylinder {
        height 0.15
        radius 0.15
      }
    }
  ]
  boundingObject USE PILLAR
}
Solid {
  translation -0.2 0.075 -0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.55 0.75
      }
      geometry Cylinder {
        height 0.15
        radius 0.1
      }
    }
  ]
  boundingObject Cylinder {
    height 0.15
    radius 0.1
  }
}

Solid {
  translation 1.2 0.004 1.2
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 0.85 0.1
        emissiveColor 0.4 0.34 0.04
        transparency 0.5
      }
      geometry Cylinder {
        height 0.008
        radius 0.15
      }
    }
  ]
}
Solid {
  translation -1.2 0.004 1.2
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 0.2 0.15
        emissiveColor 0.4 0.08 0.06
        transparency 0.5
      }
      geometry Cylinder {
        height 0.008
        radius 0.15
      }
    }
  ]
}

DEF ROBOTQ E-puck {
  translation -1.5 0.03 -1.5
  rotation 0 1 0 0.6
  name "robotQ"
  supervisor TRUE
  controller "qlearning_agent"
  controllerArgs [
    "--goal=1.2,1.2"
    "--qtable=qtable_bench_q.json"
    "--algo=qlearning"
    "--seed=1"
  ]
}
DEF ROBOTSARSA E-puck {
  translation 1.5 0.03 -1.5
  rotation 0 1 0 2.6
  name "robotSARSA"
  supervisor TRUE
  controller "qlearning_agent"
  controllerArgs [
    "--goal=-1.2,1.2"
    "--qtable=qtable_bench_sarsa.json"
    "--algo=sarsa"
    "--seed=1"
  ]
}
