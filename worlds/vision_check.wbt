#VRML_SIM R2023b utf8
# Calibration world: one beacon, one orbiting camera probe.
# Tweak --rgb/--tol on the probe until detection is solid at every angle,
# then copy the values to the vision_agent robots in vision_world.wbt.

WorldInfo {
  basicTimeStep 16
}
Viewpoint {
  orientation 1 0 0 -0.9
  position 0 2.5 2.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 4.5 4.5
  wallHeight 0.1
}
DEF BEACON Solid {
  translation 0 0.25 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.7 0.1
        emissiveColor 0.55 0.45 0.06
      }
      geometry Cylinder {
        height 0.5
        radius 0.08
      }
    }
  ]
  boundingObject Cylinder {
    height 0.5
    radius 0.08
  }
}
DEF PROBE Robot {
  translation 1.4 0.25 0
  rotation 0 1 0 1.5708
  supervisor TRUE
  controller "vision_probe"
  controllerArgs [
    "--rgb=217,178,26"
    "--tol=60"
    "--center=0,0"
    "--radius=1.4"
  ]
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.15 0.18
      }
      geometry Box {
        size 0.12 0.12 0.12
      }
    }
    Camera {
      translation 0 0 0.07
      name "camera"
      width 52
      height 44
      fieldOfView 0.95
    }
    Display {
      width 300
      height 270
    }
  ]
}
